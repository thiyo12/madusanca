# Local-only template. Copy to ignored .env.local, then fill Supabase keys with
# values from `supabase status -o env` after `supabase start`.
WDA_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_ORIGIN=
NEXT_PUBLIC_SEO_INDEXING_ENABLED=false
STRIPE_LIVE_PAYMENTS_ENABLED=false
TRUST_PROXY_IP=false

# Optional: use only a Stripe Test Mode key. Do not set RESEND_API_KEY locally.
# STRIPE_SECRET_KEY=sk_test_<local-test-key>
# STRIPE_WEBHOOK_SECRET=whsec_<local-test-webhook-secret>
