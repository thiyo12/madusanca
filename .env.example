# Supabase Environment Variables
# =============================
# These are placeholders. Never commit real credentials.
# Copy this file to .env.local and fill in your actual Supabase credentials.

# Next.js Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key for server-side use ONLY (never expose to clients)
# Keep this secret and use only in API routes or server components
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Public site origin used for absolute links and canonical SEO URLs. Keep the
# local value during development; set the verified HTTPS production origin at launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave unset until the owner confirms the official production HTTPS domain.
NEXT_PUBLIC_CANONICAL_ORIGIN=
NEXT_PUBLIC_SEO_INDEXING_ENABLED=false
# Set only after owner-authorized Search Console / Bing site verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Resend email (transactional emails — booking confirmations, contact form)
# Server-side only. Never expose to clients. Get a key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Verified sender address on your Resend domain, e.g. "Wisdom Driving Academy <bookings@yourdomain.ca>"
EMAIL_FROM=your_verified_from_address_here

# Where owner notifications are sent (new bookings, contact messages)
BOOKING_NOTIFY_EMAIL=your_owner_email_here

# Public social profiles (add the official profile URLs; leave blank until supplied)
NEXT_PUBLIC_SOCIAL_GOOGLE_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=

# Stripe hosted Checkout (secret stays server-side; use test keys for development)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_DRIVING_LESSON_TAX_CODE=txcd_20060044
